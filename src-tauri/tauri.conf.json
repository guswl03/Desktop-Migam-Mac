{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop Pet MVP",
  "version": "0.1.0",
  "identifier": "com.desktoppetmvp.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "pet",
        "title": "Desktop Pet",
        "width": 256,
        "height": 256,
        "visible": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "card",
        "title": "Desktop Pet Card",
        "width": 320,
        "height": 200,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "timer",
        "title": "Desktop Pet Timer",
        "width": 360,
        "height": 280,
        "visible": false,
        "resizable": false
      },
      {
        "label": "settings",
        "title": "Desktop Pet Settings",
        "width": 720,
        "height": 620,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self' data:; media-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../images/app/icon.ico"]
  }
}
